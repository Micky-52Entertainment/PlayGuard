{
  "name": "PlayGuard",
  "short_name": "PlayGuard",
  "description": "Checks playable ads on every screen and against the ad networks' rules.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d1117",
  "theme_color": "#1e5bff",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New check", "short_name": "Check", "url": "/?view=check", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reports", "short_name": "Reports", "url": "/?view=reports", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
