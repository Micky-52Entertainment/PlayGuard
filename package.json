{
  "name": "playable-testing-lab",
  "private": true,
  "workspaces": [
    "apps/hub",
    "apps/lab-console",
    "apps/playwright-runner",
    "packages/*"
  ],
  "scripts": {
    "hub": "npm run start -w @playable-lab/hub",
    "console": "npm run dev -w @playable-lab/lab-console",
    "replay": "npm run start -w @playable-lab/playwright-runner --",
    "test": "tsx --test packages/input-mapper/src/index.test.ts packages/orientation-guard/src/index.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
